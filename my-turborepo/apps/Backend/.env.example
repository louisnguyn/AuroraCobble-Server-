# Server
PORT=3001
CORS_ORIGIN=*

# Auth (custom users table, no Supabase Auth)
JWT_SECRET=your-secret-at-least-32-chars

# Supabase (for users, teams, gacha, user_currency)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Battle restrictions CMS (website “Restrictions” + Admin “Battle restrictions”): run SQL
# supabase/battle_restrictions_config.sql, supabase/battle_restrictions_format_label.sql (if table exists without it),
# supabase/battle_restrictions_pokemon_blacklist.sql (Pokémon blacklist columns), and
# supabase/restriction_images_storage.sql in the Supabase dashboard.

# Optional: Team Builder + ranked replay AI summaries — same OpenAI-compatible Chat Completions
# (/team/analyze-ai, POST /user/ranked-replay/ai-summary, POST /admin/ranked-replay/ai-summary)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# Optional base URL for other providers (default https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: CobbleRanked Web API — POST /usage-stats, /leaderboard, /battle-replay, /match-result (same under /api/…).
# Use the same value as CobbleRanked api.yaml auth.apiKey. Accepts Authorization: Bearer … or X-API-Key.
# Point the mod at a URL that reaches this Node process. If POSTs only hit Cloudflare Pages static HTML, use an API
# hostname or a Worker/route that forwards to the backend.
COBBLE_API_KEY=
# Optional: how many recent battle-replay and match-result bodies to keep (memory + Supabase; default 200, max 2000).
# COBBLE_RANKED_FEED_MAX=200
# After setting Supabase env vars, run repo SQL `supabase/cobble_ranked_mirror.sql` so leaderboard / usage-stats / replays survive deploys.
# Optional: max JSON body size (leaderboard + large battle-replay logs; default 32mb).
# JSON_BODY_LIMIT=32mb
# Optional: log one line to stdout when battle-replay / match-result POSTs are stored (Render logs).
# COBBLE_LOG_SYNC=true

# Optional: Discord — default webhook (Cobble$ ledger, Pokemon shop refresh, etc.)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Gacha “New Listing” (defaults to DISCORD_WEBHOOK_URL if unset)
# DISCORD_GACHA_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Ranked staff ELO add/remove (separate channel; no fallback)
# DISCORD_RANKED_ELO_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --- Minecraft admin dashboard (Query + optional RCON whitelist) ---
# MC_SERVER_HOST=127.0.0.1
# MC_SERVER_PORT=25565
# MC_QUERY_PORT=25565
# MC_QUERY_TIMEOUT_MS=8000
# Server whitelist via RCON (enable-rcon=true in server.properties)
# MC_RCON_PORT=25575
# MC_RCON_PASSWORD=
# MC_RCON_HOST=
# MC_RCON_TIMEOUT_MS=12000
# LuckPerms (website rank shop + staff grants): RCON command, no leading slash. Placeholders: {username} {role}
# MC_LUCKPERMS_PARENT_COMMAND_TEMPLATE=lp user {username} parent set {role}
# MC_EXTRA_ROSTER_NAMES=
# MC_ROSTER_INCLUDE_WEBSITE_USERS=true
# Cobble$ via RCON: runs "cobbledollars leaderboard update" then "cobbledollars leaderboard"
# MC_COBBLEDOLLARS_SKIP_UPDATE=true
# MC_COBBLEDOLLARS_DISABLE=true
# Optional: hide public website wallet Cobble$ top 10 (GET /leaderboard/website-cobbledollars).
# WEBSITE_COBBLEDOLLARS_LEADERBOARD_DISABLE=true
#
# PCO economy top 10 (public GET /minecraft/pco-leaderboard). Default RCON: pco top
# MC_PCO_DISABLE=true
# MC_PCO_TOP_COMMAND=pco top
#
# Cobblemon Battle Tower leaderboard via RCON (same MC_RCON_* as above).
# Runs: bt leaderboard <mode> top<N> — see https://modrinth.com/mod/cobblemon-battle-tower
# MC_BT_DISABLE=true
# Optional: full template (placeholders {mode} {top} — top is 10|25|50|100, no space)
# MC_BT_LEADERBOARD_COMMAND_TEMPLATE=bt leaderboard {mode} top{top}
# Public GET /minecraft/battle-tower-leaderboard uses ?mode=&top= (admin uses the same API in Server Dashboard).
#
# CobbleRanked admin ELO (Admin UI → CobbleRanked): RCON, no leading slash. Default commands:
#   rankedadmin addelo {amount} {user} {format}
#   rankedadmin removeelo {amount} {user} {format}
# {format} is SINGLES|DOUBLES by default; use lowercase only if your mod requires it:
# MC_RANKEDADMIN_ELO_FORMAT_LOWERCASE=true
# Optional full override (placeholders {amount} {user} {format}):
# MC_RANKEDADMIN_ADDELO_TEMPLATE=rankedadmin addelo {amount} {user} {format}
# MC_RANKEDADMIN_REMOVEELO_TEMPLATE=rankedadmin removeelo {amount} {user} {format}
#
# RCON must reach TCP rcon.port (often 25575), NOT the game/query port. Panel: add/forward RCON port;
# server.properties: enable-rcon=true, rcon.password=..., rcon.port=...
# See docs/MINECRAFT_RCON.md if still unreachable.
# Smoke test from apps/Backend: npm run test-rcon
#
# Gacha: claim pull in-game via RCON (Cobblemon givepokemonother). Needs MC_RCON_* above.
# MC_GACHA_CLAIM_DISABLE=true
# Optional override (default: givepokemonother {player} {species}{shiny_suffix})
# MC_GACHA_CLAIM_COMMAND_TEMPLATE=givepokemonother {player} {species}{shiny_suffix}
#
# Website Cobble$ wallet → server: POST /user/cobbledollars/deposit (currency_type cobbledollars in user_currency)
# MC_COBBLEDOLLARS_DEPOSIT_DISABLE=true
# If your mod uses different syntax, override (no leading slash; placeholders {player} {amount}):
# MC_COBBLEDOLLARS_DEPOSIT_COMMAND_TEMPLATE=cobbledollars give {player} {amount}
# Inventory claim (website inventory -> in-game via RCON)
# INVENTORY_CLAIM_COMMAND_TEMPLATE=give {player} {item_id} {amount}
#
# Pokemon shop refreshes every 4 hours (no env needed now; fixed catalog in backend)
# Website Cobble$ shop (items + Pokémon shop): discount % by users.minecraft_role — see getWebsiteShopDiscountPercent in apps/Backend/src/minecraftRoles.ts
#
# Daily PVP rank payout (from /leaderboard payload):
# automatic scheduler runs every day at 00:00 Asia/Ho_Chi_Minh
# rewards (website Cobble$) — top 3 only:
# top1=50k, top2=45k, top3=40k
# tickets (user_currency "tickets"): top1 +2, top2 +1, top3 +1 — see PVP_DAILY_TICKETS_BY_RANK in backend
# PVP top-3 order predictions (website Cobble$ stake) settle in the same run: same calendar date as payout_date, 00:00 Asia/Ho_Chi_Minh (see pvp_top_predictions.sql)
# manual trigger endpoint: POST /admin/pvp-rank/daily-payout
# set true to disable auto scheduler:
# PVP_DAILY_AUTO_PAYOUT_DISABLE=true
#
# Boss spawn cron (RCON): runs fixed raid-area boss and title/subtitle commands.
# 5-field cron syntax: minute hour day-of-month month day-of-week
# Example: every day at 20:00 Asia/Ho_Chi_Minh
# MC_BOSS_SPAWN_CRON=0 20 * * *
# Optional timezone override (default Asia/Ho_Chi_Minh)
# MC_BOSS_SPAWN_CRON_TIMEZONE=Asia/Ho_Chi_Minh
# Optional: run one cycle immediately when backend boots
# MC_BOSS_SPAWN_CRON_RUN_ON_BOOT=true
#
# Daily login streak (fixed timezone: Asia/Ho_Chi_Minh, reset 00:00)
# Reward loop: Day1 25k, Day2 35k, Day3 45k, Day4 50k, Day5 60k, Day6 70k Cobble$, Day7 Master Ball (website inventory)
