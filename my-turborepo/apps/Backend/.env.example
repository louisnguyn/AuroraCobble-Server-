# Server
PORT=3001
CORS_ORIGIN=*

# Auth (custom users table, no Supabase Auth)
JWT_SECRET=your-secret-at-least-32-chars

# Supabase (for users, teams, gacha, user_currency)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Cobble plugin
COBBLE_API_KEY=

# Optional: announce gacha pulls to Discord (webhook URL)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --- Minecraft admin dashboard (Query + optional RCON whitelist) ---
# MC_SERVER_HOST=127.0.0.1
# MC_SERVER_PORT=25565
# MC_QUERY_PORT=25565
# MC_QUERY_TIMEOUT_MS=8000
# Server whitelist via RCON (enable-rcon=true in server.properties)
# MC_RCON_PORT=25575
# MC_RCON_PASSWORD=
# MC_RCON_HOST=
# MC_RCON_TIMEOUT_MS=12000
# MC_EXTRA_ROSTER_NAMES=
# MC_ROSTER_INCLUDE_WEBSITE_USERS=true
# Cobble$ via RCON: runs "cobbledollars leaderboard update" then "cobbledollars leaderboard"
# MC_COBBLEDOLLARS_SKIP_UPDATE=true
# MC_COBBLEDOLLARS_DISABLE=true
#
# RCON must reach TCP rcon.port (often 25575), NOT the game/query port. Panel: add/forward RCON port;
# server.properties: enable-rcon=true, rcon.password=..., rcon.port=...
# See docs/MINECRAFT_RCON.md if still unreachable.
# Smoke test from apps/Backend: npm run test-rcon
#
# Gacha: claim pull in-game via RCON (Cobblemon givepokemonother). Needs MC_RCON_* above.
# MC_GACHA_CLAIM_DISABLE=true
# Optional override (default: givepokemonother {player} {species}{shiny_suffix})
# MC_GACHA_CLAIM_COMMAND_TEMPLATE=givepokemonother {player} {species}{shiny_suffix}
#
# Website Cobble$ wallet → server: POST /user/cobbledollars/deposit (currency_type cobbledollars in user_currency)
# MC_COBBLEDOLLARS_DEPOSIT_DISABLE=true
# If your mod uses different syntax, override (no leading slash; placeholders {player} {amount}):
# MC_COBBLEDOLLARS_DEPOSIT_COMMAND_TEMPLATE=cobbledollars give {player} {amount}
# Inventory claim (website inventory -> in-game via RCON)
# INVENTORY_CLAIM_COMMAND_TEMPLATE=give {player} {item_id} {amount}
#
# Pokemon shop refreshes every 4 hours (no env needed now; fixed catalog in backend)
#
# Weekly PVP rank payout (from /leaderboard payload):
# call POST /admin/pvp-rank/weekly-payout once per week
# rewards are fixed: top1=75k, top2=50k
#
# Daily login streak (fixed timezone: Asia/Ho_Chi_Minh, reset 00:00)
# Reward loop: Day1 25k, Day2 35k, Day3 45k, Day4 50k, Day5 60k, Day6 70k Cobble$, Day7 Master Ball (website inventory)
